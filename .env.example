# ---------------------------------------------------------------------------
# Security-Enhanced IoT-Based Vehicle Access Monitoring System
# Environment configuration template.
#
# Copy this file to ".env" and adjust for the target environment.
# The ".env" file MUST NEVER be committed to version control.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="Vehicle Access Monitoring System"
APP_SHORT_NAME="VAMS"
APP_ORGANIZATION="Forest Lawn Memorial Park"
APP_ENV=production            # development | testing | production
APP_DEBUG=false               # NEVER enable in production
APP_URL=https://vams.forestlawn.local
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_VERSION=1.0.0
APP_KEY=                      # 64 hex chars: php bin/console key:generate

# --- Database --------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vams
DB_USERNAME=vams_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_SOCKET=
DB_PERSISTENT=false
DB_TIMEZONE=              # blank derives the offset from APP_TIMEZONE

# --- Session ---------------------------------------------------------------
SESSION_NAME=VAMSSESSID
SESSION_LIFETIME=1800         # seconds of inactivity before automatic logout
SESSION_ABSOLUTE_LIFETIME=43200
SESSION_SECURE_COOKIE=true    # requires HTTPS
SESSION_SAME_SITE=Lax
SESSION_REGENERATE_INTERVAL=300
SESSION_SINGLE=false          # true = only one concurrent session per user

# --- Security --------------------------------------------------------------
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_HISTORY=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
CSRF_TOKEN_LIFETIME=7200
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000
TRUSTED_PROXIES=

# --- API / device communication -------------------------------------------
API_KEY_BYTES=32
API_TIMESTAMP_TOLERANCE=120   # seconds of allowed clock skew
API_NONCE_TTL=600             # seconds a nonce is remembered (replay window)
API_REQUIRE_SIGNATURE=true    # HMAC-SHA256 request signing for ESP32 devices
API_RATE_LIMIT=120            # requests / window / identity
API_RATE_WINDOW=60            # seconds
API_FLOOD_THRESHOLD=300       # requests / window before flood response
API_FLOOD_WINDOW=60
API_FLOOD_BLOCK_MINUTES=15

# --- Device / IoT ----------------------------------------------------------
DEVICE_HEARTBEAT_INTERVAL=30  # expected seconds between heartbeats
DEVICE_OFFLINE_AFTER=90       # seconds without heartbeat before "offline"
DEVICE_SCAN_DEBOUNCE=5        # seconds; duplicate scan suppression window
VISITOR_DEFAULT_VALIDITY_HOURS=12

# --- Fingerprint sensor ----------------------------------------------------
FINGERPRINT_SENSOR_CAPACITY=1000   # storage slots on an R307 / AS608
FINGERPRINT_MINIMUM_QUALITY=40     # reject enrolments the sensor scores below this
FINGERPRINT_MATCH_THRESHOLD=50     # minimum confidence for a successful match

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info                # debug | info | notice | warning | error | critical
LOG_RETENTION_DAYS=365
LOG_TO_FILE=true
LOG_TO_DATABASE=true

# --- Backup ----------------------------------------------------------------
BACKUP_PATH=database/backups
BACKUP_RETENTION=30
BACKUP_SCHEDULE="0 2 * * *"
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql

# --- Mail (optional; used for administrator alerts) ------------------------
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=vams@forestlawn.local
MAIL_FROM_NAME="VAMS Notifications"

# --- Front-end assets ------------------------------------------------------
ASSETS_USE_CDN=false          # LAN deployments must keep this false
ASSETS_VERSION=1.0.0
