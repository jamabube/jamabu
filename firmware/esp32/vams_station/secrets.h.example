/**
 * Site credentials.
 *
 * Copy to secrets.h and fill in. secrets.h is listed in .gitignore and must
 * never be committed: it carries the key that lets this station write to the
 * monitoring record.
 *
 * The API key is shown exactly once, when the station is registered in the
 * web interface or by "php bin/console device:register". The server keeps
 * only a hash of it, so a lost key cannot be recovered — it can only be
 * rotated, which then requires reflashing.
 *
 * @file
 * @version 1.0.0
 */

#pragma once

// --- Network ---------------------------------------------------------------

#define WIFI_SSID     "ForestLawn-Ops"
#define WIFI_PASSWORD "change-me"

// --- Server ----------------------------------------------------------------

/**
 * Base URL of the monitoring server, without a trailing slash.
 *
 * Prefer https. Over plain http the API key travels in a header in clear text
 * and anyone on the network can read it, which on a guardhouse LAN with a
 * shared Wi-Fi password is a real exposure rather than a theoretical one.
 */
#define API_BASE_URL "https://vams.forestlawn.local"

/**
 * The server's TLS certificate, in PEM form.
 *
 * An installation using a self-signed or private-CA certificate must pin it
 * here. Leaving this empty makes the station accept any certificate, which
 * removes the protection https was added for; it is tolerable only on a
 * closed bench during development.
 */
#define API_ROOT_CA ""

// --- Device identity -------------------------------------------------------

/** The code the server registered this station under. */
#define DEVICE_CODE "ESP32-ENTRY-01"

/** The API key issued at registration. */
#define DEVICE_API_KEY "paste-the-key-shown-at-registration"
