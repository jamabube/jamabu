# Normalise line endings so a checkout behaves the same on every machine.
* text=auto eol=lf

# Windows scripts must keep CRLF: cmd.exe mis-parses labels and goto targets
# in a batch file that uses bare LF endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets git must not touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary
