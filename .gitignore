# Environment / secrets
.env
.env.*
!.env.example
config/local.php

# Dependencies
/vendor/
/node_modules/
/public/assets/vendor/*
!/public/assets/vendor/.gitkeep
!/public/assets/vendor/README.md

# Runtime artefacts
/storage/logs/**/*.log
/storage/logs/**/*.jsonl
/storage/temp/*
/storage/cache/*
/storage/exports/*
/database/backups/*.sql
/database/backups/*.zip
/public/uploads/*
!**/.gitkeep

# Build / IDE / OS
/build/
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# Vendor RFID reader SDK
#
# The UHF long-range reader ships its own demo application, DLLs and headers
# under the manufacturer's licence. They belong on the bench machine that
# configures the reader, not in here: they are large, they are not ours to
# redistribute, and nothing the server or the firmware builds needs them.
/firmware/vendor/
/tools/vendor-sdk/
*.dll
*.lib
*.so
*.dylib

# Firmware build output
/firmware/esp32/.pio/
/firmware/esp32/build/
/firmware/esp32/include/secrets.h
